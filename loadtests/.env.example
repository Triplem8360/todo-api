# Compose interpolation and Locust runtime settings.
LOCUST_WEB_PORT=8089
LOCUST_USERS=5
LOCUST_SPAWN_RATE=1
LOCUST_RUN_TIME=25s
LOCUST_AUTOSTART=false

# Deterministic scenario data and credentials.
LOCUST_TEST_SEED=9001
LOCUST_TEST_USER_COUNT=1000
LOCUST_TEST_PASSWORD=LocustPass123!
LOCUST_SEED_TODOS_PER_USER=40

# Simulated think time between completed tasks.
LOCUST_MIN_WAIT_SECONDS=0.5
LOCUST_MAX_WAIT_SECONDS=2.0
LOCUST_MAX_TRACKED_TODOS=50

# Headless-run service-level thresholds.
LOCUST_FAILURE_RATIO_LIMIT=0.01
LOCUST_P95_MS_LIMIT=750
