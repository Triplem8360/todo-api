# Application
APP_NAME=Todo API
# Allowed: development, test, staging, production
APP_ENV=development
APP_DEBUG=false

# Trusted hosts
# Hostnames accepted in the HTTP Host header.
# Use hostnames only; do not include a scheme, path, query, fragment, or port.
# "testserver" is required by FastAPI/Starlette TestClient.
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]

# CORS
# JSON array of exact browser origins allowed to call the API.
# Each origin must include the scheme, host, and port when non-default.
# Do not include paths or use "*" because browser credentials are enabled.
CORS_ALLOWED_ORIGINS=["http://localhost:5500"]
# Browser preflight cache duration, in seconds.
CORS_MAX_AGE_SECONDS=600

# Todo response cache
CACHE_ENABLED=true
# Allowed: redis, memory. Redis is shared across API workers; memory is process-local.
CACHE_BACKEND=redis
CACHE_PREFIX=todo-api
CACHE_TTL_SECONDS=60
# Direct host execution uses this URL and the loopback port published by the Compose files.
# API containers override it with redis://redis:6379/0.
# Use rediss:// and credentials when connecting to an externally managed deployment.
# The Compose Redis memory limit defaults to 128mb and can be set with REDIS_MAX_MEMORY.
REDIS_URL=redis://localhost:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2

# APScheduler Redis job store
# Reuses REDIS_URL's server and credentials, but stores scheduler state in DB 1.
APSCHEDULER_REDIS_DB=1
APSCHEDULER_JOBS_KEY=todo-api:apscheduler:jobs
APSCHEDULER_RUN_TIMES_KEY=todo-api:apscheduler:run-times

# PostgreSQL
# Must use the asyncpg driver.
# Percent-encode special characters in username/password.
DATABASE_URL=postgresql+asyncpg://todo:todo@localhost:5432/todo
SQL_ECHO=false

# SQLAlchemy connection pool
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
DB_COMMAND_TIMEOUT_SECONDS=30
DB_HEALTHCHECK_TIMEOUT_SECONDS=2

# JWT authentication
# Replace before using staging or production.
SECRET_KEY=change-this-secret-key-in-real-projects
JWT_ALGORITHM=HS256
JWT_ISSUER=todo-api
JWT_ACCESS_AUDIENCE=todo-api
JWT_REFRESH_AUDIENCE=todo-api-refresh
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth 2.0 Authorization Code + PKCE
OAUTH2_PUBLIC_CLIENT_ID=todo-public-client
OAUTH2_REDIRECT_URIS=["http://localhost:8000/docs/oauth2-redirect","http://127.0.0.1:8000/docs/oauth2-redirect"]
OAUTH2_AUTHORIZATION_CODE_TTL_SECONDS=120

# Refresh-session security
REFRESH_SESSION_ABSOLUTE_TTL=P90D
REFRESH_TOKEN_REUSE_GRACE=PT5S

# Browser authentication cookies
# Keep false only for local HTTP development; staging/production require true.
AUTH_COOKIE_SECURE=false
# Allowed: lax, strict
AUTH_COOKIE_SAMESITE=lax

# Prometheus
METRICS_PATH=/metrics

# Email / FastAPI-Mail
# Direct host execution connects to smtp4dev through its loopback-only published port.
# compose.dev.yaml overrides these two values with smtp4dev:25 for API containers.
MAIL_SERVER=localhost
MAIL_PORT=2525
# Empty credentials are correct for the local smtp4dev service.
MAIL_USERNAME=
MAIL_PASSWORD=
USE_CREDENTIALS=false
# STARTTLS upgrades a plaintext SMTP connection; SSL_TLS starts encrypted immediately.
# They are mutually exclusive. smtp4dev runs without TLS in this local configuration.
MAIL_STARTTLS=false
MAIL_SSL_TLS=false
# Keep certificate verification enabled for real TLS servers.
VALIDATE_CERTS=true
CERT_BUNDLE=
# Message sender identity.
MAIL_FROM=noreply@example.com
MAIL_FROM_NAME=Todo API
# FastAPI-Mail debug compatibility flag. Version 1.6.5 accepts but does not consume it.
MAIL_DEBUG=0
# Set to true in unit tests to build messages without opening a network connection.
SUPPRESS_SEND=false
# SMTP connection timeout in seconds and optional EHLO hostname override.
TIMEOUT=10
LOCAL_HOSTNAME=
# Optional directory used by FastAPI-Mail for Jinja email templates.
TEMPLATE_FOLDER=

# Registration email verification
# Public URL included in verification messages. The API appends ?token=<opaque-token>.
EMAIL_VERIFICATION_URL=http://localhost:8000/api/v1/auth/email-verification/confirm
# ISO 8601 duration; verification tokens are single-use.
EMAIL_VERIFICATION_TOKEN_TTL=PT24H
# Minimum delay before another verification email can be requested for an account.
EMAIL_VERIFICATION_RESEND_COOLDOWN=PT60S
