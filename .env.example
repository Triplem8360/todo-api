# Application
APP_NAME=Todo API
# Allowed: development, test, staging, production
APP_ENV=development
APP_DEBUG=false

# PostgreSQL
# Must use the asyncpg driver.
# Percent-encode special characters in username/password.
DATABASE_URL=postgresql+asyncpg://todo:todo@localhost:5432/todo
SQL_ECHO=false

# SQLAlchemy connection pool
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_TIMEOUT_SECONDS=5
DB_COMMAND_TIMEOUT_SECONDS=30
DB_HEALTHCHECK_TIMEOUT_SECONDS=2

# JWT authentication
# Replace before using staging or production.
SECRET_KEY=change-this-secret-key-in-real-projects
JWT_ALGORITHM=HS256
JWT_ISSUER=todo-api
JWT_ACCESS_AUDIENCE=todo-api
JWT_REFRESH_AUDIENCE=todo-api-refresh
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Prometheus
METRICS_PATH=/metrics
